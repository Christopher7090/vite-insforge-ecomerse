# InsForge Backend URL
# Get from .insforge/project.json → oss_host
VITE_INSFORGE_URL=https://your-app.region.insforge.app

# InsForge Anon Key (public, safe for client-side)
# Get with: npx -y @insforge/cli secrets get ANON_KEY
VITE_INSFORGE_ANON_KEY=your-anon-key-here

# InsForge API Key (admin, used for user management REST API)
# Get with: npx -y @insforge/cli secrets get API_KEY
VITE_INSFORGE_API_KEY=your-api-key-here
